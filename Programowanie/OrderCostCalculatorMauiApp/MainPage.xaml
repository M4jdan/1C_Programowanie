<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="OrderCostCalculatorMauiApp.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="thisPage">

    <ScrollView>

        <VerticalStackLayout Padding="20"
                             Spacing="15"
                             BindingContext="{x:Reference thisPage}">

            <Label Text="Kalkulator kosztu zamówienia"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Nazwa produktu" />

            <Entry Placeholder="Podaj nazwę produktu"
                   Text="{Binding ProductName}" />

            <Label Text="Cena za sztukę" />

            <Entry Placeholder="Podaj cenę za sztukę"
                   Keyboard="Numeric"
                   Text="{Binding Price}" />

            <Label Text="Liczba sztuk" />

            <HorizontalStackLayout Spacing="10">

                <Stepper Minimum="1"
                         Maximum="10"
                         Value="{Binding NumberOfItems}" />

                <Label Text="{Binding NumberOfItems}"
                       VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Picker Title="Wybierz sposób dostawy"
                    ItemsSource="{Binding DeliveryTypes}"
                    SelectedItem="{Binding SelectedDelivery}" />

            <Button Text="Oblicz"
                    Command="{Binding CalculateCommand}" />

            <Label Text="{Binding Message}"
                   FontSize="16"
                   HorizontalTextAlignment="Center" />

            <Button
                x:Name="CounterBtn"
                Text="Click me" 
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
