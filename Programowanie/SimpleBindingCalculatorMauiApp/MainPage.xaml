<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SimpleBindingCalculatorMauiApp.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="thisPage">
    
    <StackLayout Padding="30,0" Spacing="25" BindingContext=">
        <Label Background="#E61B1B"
               BackgroundColor="#F7921B"
               FontAttributes="Bold"
               FontFamily="Arial"
               FontSize="20"
               Text="Podaj pierwszą liczbę" />
        <Entry Text="{Binding FirstNumber, Source={x:Reference thisPage}}"/>
        <StackLayout Orientation="Horizontal">
            <Label Text="Podaj drugą liczbę" VerticalTextAlignment="Center" />
            <Entry Text="{Binding SecondNumber, Source={x:Reference thisPage}}"/>
        </StackLayout>
        <Button Clicked="Button_Clicked" Text="Oblicz" />
        <Label Text="{Binding Result, Source={x:Reference thisPage}}"/>

    </StackLayout>

</ContentPage>
